# Server-only secrets
GEMINI_API_KEY=
# Emergency switch for previews, QA and incident response. Never prefix this with NEXT_PUBLIC_.
AI_REQUESTS_DISABLED=false

# Optional account sync
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (safe to include in a client build)
# Platform keys only: appl_ for iOS, goog_ for Android (also used for store sandbox).
# Never pass test_ keys to the native Release build; RevenueCat terminates the app.
# These values are read by the Vercel web build, not the Codemagic native build.
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# RevenueCat Test Store public key. It is used only when the native host reports
# a Debug build; Release builds reject it before the SDK is configured.
NEXT_PUBLIC_REVENUECAT_TEST_API_KEY=
